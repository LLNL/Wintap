<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<PublishTrimmed>false</PublishTrimmed>
	<PublishReadyToRun>true</PublishReadyToRun>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Lintap build may redirect BaseIntermediateOutputPath/BaseOutputPath to a
      VM-local temp directory when publishing this project from a host-shared mount.
      When that happens, the SDK's default obj/bin excludes no longer cover stale
      in-repo obj/bin directories. The outer Wintap/Lintap projects can also
      publish into an in-project mcp_temp directory, so explicitly exclude all
      generated publish/intermediate directories from source globs.
    -->
    <Compile Remove="obj\**\*.cs" />
    <None Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <Content Remove="obj\**" />
    <Compile Remove="bin\**\*.cs" />
    <None Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <Content Remove="bin\**" />
    <Compile Remove="mcp_temp\**\*.cs" />
    <None Remove="mcp_temp\**" />
    <EmbeddedResource Remove="mcp_temp\**" />
    <Content Remove="mcp_temp\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0-rc.1.25451.107" />
    <PackageReference Include="ModelContextProtocol" Version="0.2.0-preview.3" />
  </ItemGroup>

</Project>
