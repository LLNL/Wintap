select istream
  "File" as protocol,
  file.path as path,
  sum(file.bytesRequested) as bytesRequested,
  PID,
  PidHash,
  ProcessName,
  CAST(activityType, string) as activityType,
  min(eventTime) as firstSeen,
  max(eventTime) as lastSeen,
  count(*) as eventCount,
  'File' as MessageType,
  AgentId
from WintapMessage(CAST(messageType, string) = 'FILE' AND 
                   (CAST(activityType, string) = 'Write' OR CAST(activityType, string) = 'Read')).win:time_batch(10 sec) as msg
group by file.path, PidHash, PID, activityType, ProcessName
having count(*) > 0